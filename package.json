{
  "name": "shared-venture-workspace",
  "version": "0.2.0",
  "description": "Lightweight shared workspace for humans + Grok/Codex agents to develop business ideas",
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env --import tsx src/mcp/server.ts",
    "dev:http": "PORT=3100 node --env-file=.env --watch --import tsx src/mcp/server.ts",
    "build": "tsc",
    "start": "node dist/mcp/server.js",
    "start:http": "node dist/mcp/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "echo 'Run the SQL in supabase/migrations against your Supabase project'"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@supabase/supabase-js": "^2.45.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
