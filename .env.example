# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# MCP server
MCP_API_KEY=generate-a-long-random-string

# Optional outbound bot notification for idea.created events
# The receiving bot/relay must expose a public POST endpoint.
GROK_WEBHOOK_URL=
GROK_WEBHOOK_SECRET=

# Set PORT to enable HTTP mode (for remote Grok bots)
# Leave unset for stdio mode (local Codex / Cursor)
PORT=3100

# Optional
NODE_ENV=development
